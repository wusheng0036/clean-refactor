# Site
NEXT_PUBLIC_SITE_URL="https://cleanrefactor-ai.vercel.app"
NEXTAUTH_URL="https://cleanrefactor-ai.vercel.app"
NEXTAUTH_SECRET="replace-with-random-secret"
AUTH_SECRET="replace-with-random-secret"

# Database
DATABASE_URL="file:./dev.db"

# Google OAuth
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# PayPal
PAYPAL_CLIENT_ID="replace-with-paypal-client-id"
PAYPAL_SECRET="replace-with-paypal-secret"
PAYPAL_MODE="sandbox"
NEXT_PUBLIC_PRODUCT_PRICE="14.99"

# AI providers
SILICONFLOW_API_KEY="replace-with-siliconflow-api-key"
ZHIPU_API_KEY="replace-with-zhipu-api-key"
